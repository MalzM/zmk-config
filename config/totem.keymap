#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Media       1
#define Nav         2
#define Mouse       3
#define Sym         4
#define Num         5
#define Fun         6
#define Button      7
#define Game        8
#define Gameplus    9

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
          &kp Q  &kp W       &kp F         &kp P         &kp B        &kp J         &kp L            &kp U         &kp Y       &kp SQT
          &kp A  &hm LALT R  &hm LCTRL S   &hm LSHIFT T  &kp G        &kp M         &hm RSHFT N      &hm RCTRL E   &hm RALT I  &kp O
&kp LGUI  &kp Z  &kp X       &kp C         &kp D         &kp V        &kp K         &kp H            &kp COMMA     &kp DOT     &kp SLASH  &kp RGUI
                             &lt 5 ESCAPE  &lt 1 TAB     &kp SPACE    &lt 2 RETURN  &lt 3 BACKSPACE  &lt 4 DELETE
            >;
        };

        NAV {
            label = "Navigation";
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &kp K_REDO    &kp K_PASTE    &kp K_COPY   &kp K_CUT      &kp K_UNDO
        &trans  &trans  &trans  &trans  &trans    &kp CAPSLOCK  &kp LEFT       &kp UP       &kp DOWN       &kp RIGHT
&trans  &trans  &trans  &trans  &trans  &trans    &kp INSERT    &kp HOME       &kp PAGE_UP  &kp PAGE_DOWN  &kp END     &trans
                        &trans  &trans  &trans    &kp ENTER     &kp BACKSPACE  &kp DEL
            >;
        };

        SYM {
            label = "Symbols";
            bindings = <
        &kp ESCAPE       &kp AMPERSAND  &kp ASTERISK   &kp PERCENT  &kp GRAVE      &kp SEMICOLON  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
        &kp EXCLAMATION  &kp AT_SIGN    &kp POUND      &kp DOLLAR   &kp PERCENT    &kp MINUS      &trans            &trans             &trans                &trans
&trans  &kp CARET        &kp AMPERSAND  &kp BACKSLASH  &kp SLASH    &kp SQT        &kp EQUAL      &kp PLUS          &kp ASTERISK       &kp QUESTION          &kp EXCLAMATION        &trans
                                        &trans         &trans       &trans         &trans         &trans            &trans
            >;
        };

        NUM {
            bindings = <
        &trans                &trans                 &trans  &trans  &trans    &kp KP_PLUS   &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MULTIPLY
        &trans                &trans                 &trans  &trans  &trans    &kp KP_MINUS  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_DIVIDE
&trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans  &trans    &kp KP_EQUAL  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_NUMBER_0  &trans
                                                     &trans  &trans  &trans    &trans        &trans     &trans
            >;

            label = "Numerical";
        };

        FUN {
            label = "Functions";
            bindings = <
        &bootloader  &kp F1  &kp F2  &kp F3  &trans    &kp C_AC_INSERT  &kp C_AC_HOME  &kp PAGE_UP    &kp PRINTSCREEN    &trans
        &trans       &kp F4  &kp F5  &kp F6  &trans    &kp DEL          &kp END        &kp PAGE_DOWN  &kp C_PAUSE        &trans
&trans  &trans       &kp F7  &kp F8  &kp F9  &trans    &trans           &trans         &trans         &kp K_SCREENSAVER  &trans  &trans
                             &trans  &trans  &trans    &trans           &trans         &trans
            >;
        };

        MED {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "Media";
        };
    };
};
